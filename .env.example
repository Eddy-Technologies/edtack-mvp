# Google Analytics
GOOGLE_TAG_MANAGER_ID=your_google_tag_manager_id

# Auth
NUXT_SESSION_PASSWORD=at_least_32_chars_string\
JWT_SECRET=your_jwt_secret_64char_hexadecimal_string

# Supabase Configuration
NUXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NUXT_PUBLIC_SUPABASE_KEY=your_supabase_anon_key
NUXT_PRIVATE_SUPABASE_URL=http://127.0.0.1:54321
NUXT_PRIVATE_SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe Configuration
NUXT_STRIPE_SECRET_KEY=your_stripe_secret_key
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
NUXT_PUBLIC_STRIPE_PRICING_TABLE_ID=your_stripe_pricing_table_id
NUXT_STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
NUXT_PUBLIC_STRIPE_CUSTOMER_PORTAL_URL=your_stripe_customer_portal_url
NUXT_PUBLIC_BASE_URL=http://localhost:3000

# Google OAuth (configured in Supabase dashboard)
NUXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id

# Python Backend
NUXT_PUBLIC_CHAT_WS_URL=ws://localhost:8000
NUXT_PUBLIC_CHAT_RESPONSE_TIMEOUT=60000
NUXT_PUBLIC_PYTHON_API_URL=http://localhost:8000
# Chat mode: 'websocket' or 'sse' - controls whether to use WebSocket or SSE+API for chat
NUXT_PUBLIC_CHAT_MODE=websocket
# Chat auth: whether the RAG backend requires authentication (matches AUTH_ENABLED on backend)
# Set to 'true' in production, 'false' for local development without auth
NUXT_PUBLIC_CHAT_AUTH_ENABLED=false

# Feature Flags
# Set to 'true' in development to enable features that are hidden in production
NUXT_PUBLIC_FEATURES_SUBSCRIPTION_PLANS=true
