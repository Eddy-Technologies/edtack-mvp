    "@nuxt/ui": "^2.21.1",
    "@nuxtjs/mdc": "^0.9.5",
    "@nuxtjs/supabase": "^1.5.1",
    "@pinia/nuxt": "^0.10.1",
    "@stripe/stripe-js": "^7.5.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.4",
    "@unhead/vue": "^2.0.3",
    "jsonwebtoken": "^9.0.2",
    "katex": "^0.16.21",
    "nuxt": "^3.16.1",
    "nuxt-auth-utils": "^0.3.9",
    "nuxt-gtag": "3.0.2",
    "nuxt-toastify": "^1.0.0",
    "openai": "^4.89.0",
